# Copy to .env (gitignored) for local development. These credentials belong to the throwaway
# Postgres from docker-compose.yml and are not secrets; never put a real database URL here.
DATABASE_URL=postgresql+psycopg://expensior:expensior@localhost:5432/expensior

# The bank API (Enable Banking), needed only by the bank commands. The application id is shown in the
# Control Panel; the private key stays in a file outside the repository (mode 600), only its path is
# set here. The redirect URL must be one of those whitelisted for the application.
# ENABLE_BANKING_APP_ID=<application id from the Control Panel>
# ENABLE_BANKING_KEY_PATH=~/.config/expensior/enablebanking.pem
# ENABLE_BANKING_REDIRECT_URL=https://example.com/callback
